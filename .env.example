# Local development: start the Datastore-mode emulator separately.
DATASTORE_EMULATOR_HOST=127.0.0.1:8791
ATLAS_PROJECT=atlas-local
ATLAS_NAMESPACE=atlas
ATLAS_STORAGE=local
ATLAS_DATA_DIR=.local/objects
ATLAS_JOBS=local
ATLAS_PUBLIC_URL=http://127.0.0.1:5178

# vertex = Gemini models on Vertex AI using Application Default Credentials.
# offline = explicit text/Markdown-only development provider, no paid calls.
ATLAS_PROVIDER=vertex
# Blank uses the project resolved by gcloud ADC for local development.
# In deployment, this is set to the Google Cloud resource project.
ATLAS_VERTEX_PROJECT=
ATLAS_VERTEX_LOCATION=global
ATLAS_EMBEDDING_MODEL=gemini-embedding-2
ATLAS_ANSWER_MODEL=gemini-3.5-flash-lite
ATLAS_DIMENSIONS=768
ATLAS_DAILY_AI_CALLS=5000
ATLAS_REQUESTS_PER_MINUTE=90
ATLAS_UPLOAD_SESSIONS_PER_DAY=1000
ATLAS_MAX_UPLOAD_MB=100
ATLAS_MAX_FILE_CHUNKS=250
ATLAS_MAX_CHUNKS=10000
